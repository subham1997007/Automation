.DS_Store
.env.local
.github/
.vscode/
mcp-server.log
**/.venv/
**/__pycache__/
**/*.pyc

# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
*.last-valid
*.token
*.secret

# ── Generated memory files — machine-specific, re-generated by install.sh ─────
.memory/
# (entire .memory/ excluded — rebuilt on first run by install.sh + refresh_memory.py)

# ── FAISS / turbovec vector indexes — machine-specific ────────────────────────
.memory/*.faiss
.memory/*.pkl
.memory/*.tvim
.memory/faiss_index/
.memory/code-vectorstore/

# ── Runtime worktrees & logs ──────────────────────────────────────────────────
runtime/worktrees/*
runtime/logs/*
!runtime/worktrees/.gitkeep
!runtime/logs/.gitkeep

# ── Reports ───────────────────────────────────────────────────────────────────
reports/**/*.html
reports/**/*.json

# ── Local brain models (large binary files) ──────────────────────────────────
models/
*.gguf
*.bin
*.safetensors
