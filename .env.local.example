# ═══════════════════════════════════════════════════════════════════════
#  Automation DevFlow — Credentials Template
#  Copy this file to .env.local and fill in your values.
#  .env.local is git-ignored — NEVER commit real credentials.
# ═══════════════════════════════════════════════════════════════════════

# ── Jira (required) ──────────────────────────────────────────────────
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your-jira-api-token

# ── GitLab (required for MR creation) ────────────────────────────────
GITLAB_BASE_URL=https://gitlab.your-company.com
GITLAB_TOKEN=your-gitlab-personal-access-token
GITLAB_PROJECT_ID=12345
GITLAB_PROJECT_PATH=group/your-repo

# ── Confluence (optional — for ADR/doc caching) ──────────────────────
# CONFLUENCE_BASE_URL=https://your-company.atlassian.net
# CONFLUENCE_USERNAME=your.email@company.com
# CONFLUENCE_API_TOKEN=your-confluence-api-token
# CONFLUENCE_SPACE_KEY=YOURSPACE

# ── Databricks (optional — enables Databricks MCP tools) ─────────────
# DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
# DATABRICKS_TOKEN=dapi...

# ── OpenAI (optional — enables LLM-powered AC + MR description gen) ──
# OPENAI_API_KEY=sk-...

# ── Jira custom fields (vary per Jira org — check field IDs in your setup) ──
# JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_XXXXX
# JIRA_ACCEPTANCE_CRITERIA_FIELD_FORMAT=adf
# JIRA_REGULATORY_JUSTIFICATION_FIELD=customfield_XXXXX
# JIRA_REGULATORY_JUSTIFICATION_FIELD_FORMAT=adf
# JIRA_REASON_COMMENTS_FIELD=customfield_XXXXX
# JIRA_REASON_COMMENTS_FIELD_FORMAT=adf

# ── Optional Jira defaults ────────────────────────────────────────────
# JIRA_SUBTASK_ISSUE_TYPE=Sub-task
# JIRA_DEFAULT_SUBTASK_PRIORITY=Medium
# JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=
